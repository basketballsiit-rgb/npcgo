generator client {
  provider = "prisma-client-js"
  output   = "./generated/client-job"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL_JOB")
}

model Departments {
  id         Int      @id @default(autoincrement())
  name       String   @db.VarChar(255)
  created_at DateTime @default(now()) @db.Timestamp(0)
  jobs       jobs[]
  users      users[]

  @@map("departments")
}

model evaluation_criteria {
  id                          Int                           @id @default(autoincrement())
  parent_id                   Int?
  title                       String                        @db.VarChar(255)
  description                 String?                       @db.Text
  max_score                   Decimal                       @default(10.00) @db.Decimal(5, 2)
  sort_order                  Int?                          @default(0)
  created_at                  DateTime                      @default(now()) @db.Timestamp(0)
  updated_at                  DateTime                      @default(now()) @db.Timestamp(0)
  evaluation_criteria         evaluation_criteria?          @relation("evaluation_criteriaToevaluation_criteria", fields: [parent_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_parent_criteria")
  other_evaluation_criteria   evaluation_criteria[]         @relation("evaluation_criteriaToevaluation_criteria")
  evaluation_criteria_inputs  evaluation_criteria_inputs[]
  evaluation_evaluator_scores evaluation_evaluator_scores[]

  @@index([parent_id], map: "fk_parent_criteria")
}

model evaluation_criteria_inputs {
  id                     Int                  @id @default(autoincrement())
  evaluation_instance_id Int
  criteria_id            Int
  staff_input_text       String?              @db.Text
  staff_attachment       String?              @db.VarChar(255)
  evaluation_criteria    evaluation_criteria  @relation(fields: [criteria_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "evaluation_criteria_inputs_ibfk_2")
  evaluation_instances   evaluation_instances @relation(fields: [evaluation_instance_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_crit_inputs_instance")

  @@unique([evaluation_instance_id, criteria_id], map: "uq_input")
  @@index([criteria_id], map: "criteria_id")
}

model evaluation_evaluator_scores {
  id                             Int                         @id @default(autoincrement())
  evaluation_evaluator_status_id Int
  criteria_id                    Int
  score                          Decimal                     @default(0.00) @db.Decimal(5, 2)
  comment                        String?                     @db.Text
  evaluation_evaluator_status    evaluation_evaluator_status @relation(fields: [evaluation_evaluator_status_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "evaluation_evaluator_scores_ibfk_1")
  evaluation_criteria            evaluation_criteria         @relation(fields: [criteria_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "evaluation_evaluator_scores_ibfk_2")

  @@unique([evaluation_evaluator_status_id, criteria_id], map: "uq_ev_score")
  @@index([criteria_id], map: "criteria_id")
}

model evaluation_evaluator_status {
  id                          Int                                @id @default(autoincrement())
  evaluation_instance_id      Int
  evaluator_id                Int
  status                      evaluation_evaluator_status_status @default(pending)
  total_score                 Decimal?                           @default(0.00) @db.Decimal(5, 2)
  created_at                  DateTime                           @default(now()) @db.Timestamp(0)
  updated_at                  DateTime                           @default(now()) @db.Timestamp(0)
  evaluation_evaluator_scores evaluation_evaluator_scores[]
  users                       users                              @relation(fields: [evaluator_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "evaluation_evaluator_status_ibfk_2")
  evaluation_instances        evaluation_instances               @relation(fields: [evaluation_instance_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_eval_status_instance")

  @@unique([evaluation_instance_id, evaluator_id], map: "uq_ev_status")
  @@index([evaluator_id], map: "evaluator_id")
}

model evaluation_hierarchies {
  id                                                 Int      @id @default(autoincrement())
  evaluatee_job_id                                   Int
  evaluator_job_id                                   Int
  level                                              Int?     @default(1)
  created_at                                         DateTime @default(now()) @db.Timestamp(0)
  jobs_evaluation_hierarchies_evaluatee_job_idTojobs jobs     @relation("evaluation_hierarchies_evaluatee_job_idTojobs", fields: [evaluatee_job_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_evaluatee_job")
  jobs_evaluation_hierarchies_evaluator_job_idTojobs jobs     @relation("evaluation_hierarchies_evaluator_job_idTojobs", fields: [evaluator_job_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_evaluator_job")

  @@unique([evaluatee_job_id, evaluator_job_id], map: "uq_eval")
  @@index([evaluator_job_id], map: "fk_evaluator_job")
}

model evaluation_instances {
  id                          Int                           @id @default(autoincrement())
  round_id                    Int
  evaluatee_id                Int
  evaluated_job_id            Int?
  status                      evaluation_instances_status   @default(pending_staff)
  total_score_average         Decimal?                      @default(0.00) @db.Decimal(5, 2)
  created_at                  DateTime                      @default(now()) @db.Timestamp(0)
  updated_at                  DateTime                      @default(now()) @db.Timestamp(0)
  evaluation_criteria_inputs  evaluation_criteria_inputs[]
  evaluation_evaluator_status evaluation_evaluator_status[]
  evaluation_rounds           evaluation_rounds             @relation(fields: [round_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "evaluation_instances_ibfk_1")
  users                       users                         @relation(fields: [evaluatee_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "evaluation_instances_ibfk_2")
  jobs                        jobs?                         @relation(fields: [evaluated_job_id], references: [id], onUpdate: Restrict, map: "fk_evaluated_job")

  @@unique([round_id, evaluatee_id, evaluated_job_id], map: "uq_inst")
  @@index([evaluated_job_id], map: "fk_evaluated_job")
  @@index([evaluatee_id], map: "idx_evaluatee_id")
  @@index([round_id], map: "idx_round_id")
}

model evaluation_rounds {
  id                   Int                      @id @default(autoincrement())
  title                String                   @db.VarChar(255)
  target_score         Decimal?                 @default(100.00) @db.Decimal(5, 2)
  status               evaluation_rounds_status @default(open)
  start_date           DateTime?                @db.Date
  end_date             DateTime?                @db.Date
  created_at           DateTime                 @default(now()) @db.Timestamp(0)
  evaluation_instances evaluation_instances[]
}

model jobs {
  id                                                                   Int                      @id @default(autoincrement())
  department_id                                                        Int
  title                                                                String                   @db.VarChar(255)
  job_level                                                            Int?                     @default(1)
  description                                                          String?                  @db.Text
  created_at                                                           DateTime                 @default(now()) @db.Timestamp(0)
  evaluation_hierarchies_evaluation_hierarchies_evaluatee_job_idTojobs evaluation_hierarchies[] @relation("evaluation_hierarchies_evaluatee_job_idTojobs")
  evaluation_hierarchies_evaluation_hierarchies_evaluator_job_idTojobs evaluation_hierarchies[] @relation("evaluation_hierarchies_evaluator_job_idTojobs")
  evaluation_instances                                                 evaluation_instances[]
  departments                                                          Departments              @relation(fields: [department_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "jobs_ibfk_1")
  user_jobs                                                            user_jobs[]
  users                                                                users[]

  @@index([department_id], map: "department_id")
}

model settings {
  setting_key   String   @id @db.VarChar(50)
  setting_value String?  @db.Text
  updated_at    DateTime @default(now()) @db.Timestamp(0)
}

model user_jobs {
  id         Int      @id @default(autoincrement())
  user_id    Int
  job_id     Int
  created_at DateTime @default(now()) @db.Timestamp(0)
  users      users    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "user_jobs_ibfk_1")
  jobs       jobs     @relation(fields: [job_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "user_jobs_ibfk_2")

  @@unique([user_id, job_id], map: "uq_user_job")
  @@index([job_id], map: "job_id")
}

model users {
  id                          Int                           @id @default(autoincrement())
  prefix                      String?                       @db.VarChar(50)
  firstname                   String                        @db.VarChar(100)
  lastname                    String                        @db.VarChar(100)
  username                    String                        @unique(map: "username") @db.VarChar(100)
  password                    String                        @db.VarChar(255)
  role                        users_role                    @default(staff)
  department_id               Int?
  job_id                      Int?
  profile_image               String?                       @db.VarChar(255)
  line_user_id                String?                       @db.VarChar(255)
  created_at                  DateTime                      @default(now()) @db.Timestamp(0)
  updated_at                  DateTime                      @default(now()) @db.Timestamp(0)
  evaluation_evaluator_status evaluation_evaluator_status[]
  evaluation_instances        evaluation_instances[]
  user_jobs                   user_jobs[]
  departments                 Departments?                  @relation(fields: [department_id], references: [id], onUpdate: Restrict, map: "users_ibfk_1")
  jobs                        jobs?                         @relation(fields: [job_id], references: [id], onUpdate: Restrict, map: "users_ibfk_2")

  @@index([department_id], map: "department_id")
  @@index([job_id], map: "job_id")
}

enum evaluation_evaluator_status_status {
  pending
  completed
}

enum evaluation_rounds_status {
  open
  closed
}

enum evaluation_instances_status {
  pending_staff
  pending_evaluator
  completed
}

enum users_role {
  admin
  evaluator
  staff
}
